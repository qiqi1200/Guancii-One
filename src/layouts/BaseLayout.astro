---
import site from '../site.json';
const SITE = site;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EntryAnimation from '../components/EntryAnimation.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  current?: string;
  veil?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.avatar,
  current,
  veil = false
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon（多尺寸适配） -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <!-- 资源预连接（加速第三方资源加载） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://img.260607.best" />

    <!-- 预加载壁纸（桌面端+移动端各一张，不随主题切换） -->
    <link rel="preload" as="image" href="https://img.260607.best/i/20260822051329_tik6.jpg" />
    <link rel="preload" as="image" href="https://img.260607.best/i/20260822082649_vwh9.jpg" />

    <!-- 字体：Montserrat + 手写体 Architects Daughter + Material Symbols -->
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100..900&family=Architects+Daughter&family=Ma+Shan+Zheng&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />

    <!-- FancyBox：文章图片点击放大 + 图库导航 -->
    <link rel="stylesheet" href="/fancybox/fancybox.css" />

    <!-- 主题预检脚本（默认浅色，尊重用户已保存的偏好） -->
    <script is:inline>
      (function() {
        // 读取用户保存的主题偏好，如无则默认浅色
        var saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        }
      })();
    </script>

    <!-- 51.la 访问统计 -->
    <script charset="UTF-8" id="LA_COLLECT" src="//sdk.51.la/js-sdk-pro.min.js" async></script>
    <script>
      // SDK 为 async 加载，需等其就绪后再初始化，避免 LA is not defined
      window.addEventListener('load', function () {
        if (window.LA && typeof window.LA.init === 'function') {
          LA.init({ id: '3QTlGG2A1JijpoBK', ck: '3QTlGG2A1JijpoBK' });
        }
      });
    </script>
  </head>
  <body class:list={['min-h-screen flex flex-col bg-[rgb(var(--bg))] text-[rgb(var(--fg))] transition-colors', veil && 'bg-veil']}>
    <!-- 入场动画：手写「Guancii的秘密基地」（每会话一次，≤2s） -->
    <EntryAnimation />

    <!-- 液态玻璃折射滤镜挂载点（由脚本按元素尺寸动态注入 SDF 位移贴图） -->
    <svg id="lens-defs" width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs></defs>
    </svg>

    <!-- 背景图片层（全屏、固定、下层）
         单壁纸方案：不随明暗切换，主题切换只改变遮罩与卡片颜色 -->
    <div id="bg-layer" aria-hidden="true">
      <img id="bg-desktop" class="bg-desktop" src="https://img.260607.best/i/20260822051329_tik6.jpg" alt="" />
      <img id="bg-mobile" class="bg-mobile" src="https://img.260607.best/i/20260822082649_vwh9.jpg" alt="" />
      <div id="bg-overlay"></div>
    </div>
    <!-- 鼠标光晕 -->
    <div class="cursor-blob" id="cursor-blob"></div>

    <!-- TOP ROW: Navbar -->
    <div id="top-row" class="z-50 pointer-events-none relative max-w-[var(--page-width,72rem)] px-4 md:px-0 mx-auto">
      <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all z-50">
        <Header current={current} />
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="w-full z-30 pointer-events-none">
      <div class="relative max-w-[var(--page-width,72rem)] mx-auto pointer-events-auto">
        <div id="main-grid" class="w-full left-0 right-0 grid grid-cols-1 lg:grid-cols-[260px_1fr] mx-auto gap-8 px-6 md:px-6">

          <!-- Sidebar (left, second row on mobile, first column on desktop) -->
          <div class="mb-4 row-start-2 lg:row-start-1 lg:col-span-1 onload-animation">
            <slot name="sidebar" />
          </div>

          <!-- Main content (right, first on mobile, second column on desktop) -->
          <main class="col-span-1 lg:col-span-1 overflow-hidden" id="swup-container">
            <div id="content-wrapper" class="page-entrance onload-animation">
              <slot />
            </div>
          </main>

        </div>
      </div>
    </div>

    <!-- Footer -->
    <Footer />

    <!-- 返回顶部按钮 -->
    <button
      id="back-to-top"
      aria-label="返回顶部"
      class="no-print fixed bottom-6 right-6 w-12 h-12 rounded-full bg-[rgb(var(--primary-light))] text-[rgb(var(--fg-on-primary))] shadow-lg hover:shadow-[0_0_20px_rgba(255,182,147,0.5)] hover:-translate-y-0.5 transition-all duration-300 opacity-0 pointer-events-none z-30 flex items-center justify-center"
    >
      <span class="material-symbols-outlined text-lg">arrow_upward</span>
    </button>

    <script is:inline>
      // 返回顶部按钮（带节流）
      const backBtn = document.getElementById('back-to-top');
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            if (window.scrollY > 600) {
              backBtn?.classList.remove('opacity-0', 'pointer-events-none');
              backBtn?.classList.add('opacity-100');
            } else {
              backBtn?.classList.add('opacity-0', 'pointer-events-none');
              backBtn?.classList.remove('opacity-100');
            }
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
      backBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // reduced-motion：跳过所有 JS 动画，直接显示全部内容
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('.onload-animation, .scroll-reveal').forEach(el => {
          el.classList.add('is-visible');
        });
        var __blob = document.getElementById('cursor-blob');
        if (__blob) __blob.style.display = 'none';
      }

      // 页面加载交错入场：保持原有 CSS transition 方案，原样不动
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const staggerItems = document.querySelectorAll('.onload-animation');
        staggerItems.forEach((el, i) => {
          const delay = parseInt(el.dataset.stagger || '0') || (i * 50);
          setTimeout(() => {
            el.classList.add('is-visible');
          }, delay);
        });
      }
    </script>

    <script>
      /* ============================================================
         液态玻璃折射引擎
         为每个 .liquid-glass / .card-base 生成「几何透镜」位移贴图：
         - 圆角矩形 SDF，边缘沿法线向内折射、平方衰减，中心零畸变
         - 位移始终指向内部 → 不采样界外像素 → 无黑边杂色
         - color-interpolation-filters=sRGB → 色彩不发闷
         - 仅 Chromium 启用；其余浏览器保持 CSS 回退（清透无模糊）
         - 侧边栏 #sidebar 内的元素不参与，保持毛玻璃材质
         ============================================================ */
      const SVGNS = 'http://www.w3.org/2000/svg';
      const XLINK = 'http://www.w3.org/1999/xlink';
      const isChromium = !!window.chrome || /Chrom(e|ium)/.test(navigator.userAgent);

      function roundedRectSDF(px: number, py: number, hw: number, hh: number, r: number): number {
        const qx = Math.abs(px) - hw + r, qy = Math.abs(py) - hh + r;
        const ax = Math.max(qx, 0), ay = Math.max(qy, 0);
        return Math.sqrt(ax * ax + ay * ay) + Math.min(Math.max(qx, qy), 0) - r;
      }

      function makeLensFilter(id: string, w: number, h: number, radius: number): SVGFilterElement {
        // 低分辨率绘制贴图，放大时自然平滑（连续丝滑的折射）
        const mw = Math.max(2, Math.round(w / 2)), mh = Math.max(2, Math.round(h / 2));
        const hw = mw / 2, hh = mh / 2;
        const rr = Math.min(radius, w / 2, h / 2) / 2;
        const band = Math.max(4, Math.min(13, Math.min(mw, mh) * 0.10)); // 窄折射带（约 8–26px），避免宽带剪切细线产生锯齿棱角
        const scale = Math.max(10, Math.min(30, Math.round(Math.min(w, h) * 0.10))); // 弱位移，边缘干净整齐

        const sdf = new Float32Array(mw * mh);
        let i = 0;
        for (let y = 0; y < mh; y++)
          for (let x = 0; x < mw; x++)
            sdf[i++] = roundedRectSDF(x + .5 - hw, y + .5 - hh, hw, hh, rr);

        const c = document.createElement('canvas');
        c.width = mw; c.height = mh;
        const ctx = c.getContext('2d')!;
        const img = ctx.createImageData(mw, mh), d = img.data;
        i = 0;
        for (let y = 0; y < mh; y++) {
          for (let x = 0; x < mw; x++) {
            const idx = y * mw + x;
            const depth = -sdf[idx];                                // 内部深度 ≥ 0
            const t = Math.min(1, depth / band);
            const amp = Math.pow(1 - t, 2);                         // 边缘最强，向内平方衰减
            let nx = 0, ny = 0;
            if (amp > 0.001) {
              const xl = sdf[y * mw + Math.max(0, x - 1)], xr = sdf[y * mw + Math.min(mw - 1, x + 1)];
              const yt = sdf[Math.max(0, y - 1) * mw + x], yb = sdf[Math.min(mh - 1, y + 1) * mw + x];
              const gx = xr - xl, gy = yb - yt;
              const len = Math.sqrt(gx * gx + gy * gy) || 1;
              nx = gx / len; ny = gy / len;                         // 外法线；取样取其反向（向内）
            }
            d[i++] = 128 - nx * amp * 127;                          // R → x 位移
            d[i++] = 128 - ny * amp * 127;                          // G → y 位移
            d[i++] = 128; d[i++] = 255;
          }
        }
        ctx.putImageData(img, 0, 0);

        const f = document.createElementNS(SVGNS, 'filter');
        f.setAttribute('id', id);
        f.setAttribute('x', '0%'); f.setAttribute('y', '0%');
        f.setAttribute('width', '100%'); f.setAttribute('height', '100%');
        f.setAttribute('color-interpolation-filters', 'sRGB');
        const im = document.createElementNS(SVGNS, 'feImage');
        const url = c.toDataURL('image/png');
        im.setAttribute('href', url);
        im.setAttributeNS(XLINK, 'xlink:href', url);
        im.setAttribute('x', '0'); im.setAttribute('y', '0');
        im.setAttribute('width', String(w)); im.setAttribute('height', String(h));
        im.setAttribute('preserveAspectRatio', 'none');
        im.setAttribute('result', 'map');
        const dm = document.createElementNS(SVGNS, 'feDisplacementMap');
        dm.setAttribute('in', 'SourceGraphic');
        dm.setAttribute('in2', 'map');
        dm.setAttribute('scale', String(scale));
        dm.setAttribute('xChannelSelector', 'R');
        dm.setAttribute('yChannelSelector', 'G');
        f.appendChild(im); f.appendChild(dm);
        return f;
      }

      const LENS_SELECTOR =
        '.liquid-glass, .card-base, .ios-surface, .scrapbook-card, .liquid-glass-vibe, .liquid-glass-pure, [data-lens]';
      let lensSeq = 0;

      function lensTarget(el: Element): el is HTMLElement {
        return el instanceof HTMLElement && !el.closest('#sidebar');   // 侧边栏保持毛玻璃
      }

      function applyLensTo(el: HTMLElement) {
        if (!isChromium) return;
        const defs = document.querySelector('#lens-defs defs');
        if (!defs) return;
        const r = el.getBoundingClientRect();
        const w = Math.round(r.width), h = Math.round(r.height);
        if (w < 4 || h < 4) return;                                    // 不可见/未布局，跳过
        const cs = getComputedStyle(el);
        const rad = Math.max(
          parseFloat(cs.borderTopLeftRadius) || 0,
          parseFloat(cs.borderTopRightRadius) || 0,
          parseFloat(cs.borderBottomLeftRadius) || 0,
          parseFloat(cs.borderBottomRightRadius) || 0
        );
        // 尺寸/圆角没变的元素直接复用已有滤镜（跳过 canvas 重绘与 feImage 解码）
        const sig = `${w}x${h}x${rad}`;
        const val = `url(#${el.dataset.lensId}) saturate(1.8) brightness(1.07)`;
        if (el.dataset.lensId && el.dataset.lensSig === sig) {
          if (el.style.backdropFilter !== val) {
            el.style.webkitBackdropFilter = val;
            el.style.backdropFilter = val;
          }
          return;
        }
        if (!el.dataset.lensId) el.dataset.lensId = `lens-${lensSeq++}-${w}x${h}`;
        const id = el.dataset.lensId;
        el.dataset.lensSig = sig;
        document.getElementById(id)?.remove();
        defs.appendChild(makeLensFilter(id, w, h, rad));
        el.style.webkitBackdropFilter = val;
        el.style.backdropFilter = val;
      }

      function applyLens() {
        document.querySelectorAll<HTMLElement>(LENS_SELECTOR).forEach((el) => {
          if (lensTarget(el)) applyLensTo(el);
        });
      }

      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(applyLens, 250);
      });
      applyLens();                                                  // DOM 就绪立即执行
      window.addEventListener('load', applyLens);
      setTimeout(applyLens, 600);                                   // 字体/图片加载后校准尺寸

      /* 入场动画结束后摘除动画类，彻底释放合成层，
         确保 backdrop-filter 能采样到页面背景（折射生效） */
      document.querySelectorAll('.page-entrance').forEach((el) => {
        el.addEventListener('animationend', () => {
          el.classList.remove('page-entrance');
          applyLens();
        }, { once: true });
      });

      /* 延迟显示的元素（如导航下拉、折叠面板）首次可见时补上滤镜 */
      const lensIO = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && lensTarget(e.target)) {
            applyLensTo(e.target as HTMLElement);
            lensIO.unobserve(e.target);
          }
        });
      }, { threshold: 0 });
      document.querySelectorAll(LENS_SELECTOR).forEach((el) => {
        if (lensTarget(el)) lensIO.observe(el);
      });

      /* DOM 变更（动态插入卡片等）后自动重扫；扫描期间暂停观察防止自触发。
         只有当新增节点里确实包含折射目标时才重建（评论加载等普通插入直接跳过） */
      let moTimer: ReturnType<typeof setTimeout>;
      const mo = new MutationObserver((records) => {
        let relevant = false;
        for (const rec of records) {
          for (const node of rec.addedNodes) {
            if (node.nodeType !== 1) continue;
            const el = node as Element;
            if (el.matches(LENS_SELECTOR) || el.querySelector(LENS_SELECTOR)) {
              relevant = true;
              break;
            }
          }
          if (relevant) break;
        }
        if (!relevant) return; // 无关变更（评论列表、文本节点等）不触发任何重扫
        clearTimeout(moTimer);
        moTimer = setTimeout(() => {
          mo.disconnect();
          try {
            applyLens();
            document.querySelectorAll(LENS_SELECTOR).forEach((el) => {
              if (lensTarget(el)) lensIO.observe(el);
            });
          } finally {
            mo.observe(document.body, { childList: true, subtree: true });
          }
        }, 350);
      });
      mo.observe(document.body, { childList: true, subtree: true });
    </script>

    <script>
      /* ============================================================
         滚动显现动画 — anime.js v4 驱动
         只动 opacity 与 transform（合成器路径，不触发 layout/paint），
         out(3) 缓动更顺滑；结束后交还 .is-visible 类，
         清掉内联样式，保证 backdrop-filter 采样边界干净。
         （页面加载入场、玻璃折射与打字机效果均保持原样，不在此范围内）
         ============================================================ */
      import { animate } from 'animejs';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 鼠标光晕（非触控 & 未开启省流动画时）：合成器路径移动；滚动期间暂停
      const blob = document.getElementById('cursor-blob');
      if (blob && !window.matchMedia('(hover: none)').matches && !reduceMotion) {
        document.addEventListener('mousemove', (e) => {
          blob.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`;
        });
        let blobTimer: ReturnType<typeof setTimeout>;
        window.addEventListener('scroll', () => {
          blob.classList.add('blob-paused');
          clearTimeout(blobTimer);
          blobTimer = setTimeout(() => blob.classList.remove('blob-paused'), 180);
        }, { passive: true });
      }

      if (!reduceMotion) {
        // 单元素显现：按变体类选择起始位移，结束后还原为类驱动最终态
        const revealEl = (el: HTMLElement, delay = 0) => {
          el.style.transition = 'none'; // anime.js 全权驱动，避免与 CSS transition 叠加
          const params: Record<string, unknown> = {
            opacity: [0, 1],
            duration: 620,
            delay,
            ease: 'out(3)',
            onComplete: () => {
              el.style.transition = '';
              el.style.opacity = '';
              el.style.transform = '';
              el.classList.add('is-visible'); // 终态回归 CSS 类，内联样式清零
            },
          };
          if (el.classList.contains('left')) params.x = [-20, 0];
          else if (el.classList.contains('right')) params.x = [20, 0];
          else if (el.classList.contains('scale')) { params.y = [8, 0]; params.scale = [0.96, 1]; }
          else params.y = [16, 0];
          animate(el, params);
        };

        // 滚动显现：同一帧进入的多个元素按顺序微交错
        const io = new IntersectionObserver((entries) => {
          const hits = entries.filter(e => e.isIntersecting);
          if (!hits.length) return;
          hits.forEach((en, i) => {
            io.unobserve(en.target);
            revealEl(en.target as HTMLElement, i * 70);
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.scroll-reveal').forEach(el => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  :root {
    --content-delay: 0ms;
    --page-width: 72rem;
  }

  /* 鼠标光晕：滚动期间淡出暂停，停止后恢复（减少滚动时的无效重采样） */
  #cursor-blob {
    transition: width 0.3s, height 0.3s, opacity 0.22s var(--ease-smooth);
  }
  #cursor-blob.blob-paused {
    opacity: 0;
  }

  /* iOS 风格字号相关 tracking — 大字号收紧，正文放松 */
  h1, h2, h3, h4, h5, h6 {
    letter-spacing: -0.02em;
  }
  body {
    letter-spacing: 0.01em;
  }

  /* ════════════════════════════════════════════
     背景图层 — 全屏固定，单壁纸常驻
     
     桌面端（>768px）与移动端（≤768px）各一张壁纸，
     不随明暗主题切换；主题切换只改变遮罩与卡片颜色。
     全屏 position: fixed，背景永不滚动
     ════════════════════════════════════════════ */
  #bg-layer {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  #bg-layer img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── 默认：桌面端显示横版，隐藏竖版 ── */
  .bg-desktop { display: block; }
  .bg-mobile  { display: none; }

  /* ── 近透明遮罩 — 保持原图清晰，仅留极轻底色保证文字可读 ── */
  #bg-overlay {
    position: absolute;
    inset: 0;
    background: rgb(var(--bg) / 0.08);
    transition: background 0.9s cubic-bezier(0.23, 1, 0.32, 1);
  }
  :global(.dark) #bg-overlay {
    background: rgb(17 19 28 / 0.28);
  }

  /* ── 文章页背景遮盖（veil）— 壁纸隐约可见，长文阅读更专注 ── */
  body.bg-veil #bg-overlay {
    background: rgb(var(--bg) / 0.7);
  }
  :global(html.dark) body.bg-veil #bg-overlay {
    background: rgb(17 19 28 / 0.66);
  }

  /* ── 移动端（≤768px）：切换竖版壁纸 + iOS 优化 ── */
  @media (max-width: 768px) {
    /* 隐藏桌面横版壁纸，显示移动端竖版壁纸 */
    .bg-desktop { display: none; }
    .bg-mobile  { display: block; }

    /* 竖版壁纸：cover 铺满，居中对齐 + 顶部优先，确保主体完整可见 */
    #bg-layer img.bg-mobile {
      object-fit: cover;
      object-position: center top;
    }

    /* #bg-layer 保持 position: fixed（继承自桌面端），背景永不随页面滚动 */
    /* translateZ(0) 强制 GPU 合成层，iOS Safari 下减少背景重绘开销 */
    #bg-layer {
      -webkit-transform: translateZ(0);
      transform: translateZ(0);
    }
  }

  /* 缩短上滑距离，加快入场，更 iOS
     backwards：结束后释放关键帧样式，避免合成层驻留切断折射采样 */
  .page-entrance {
    animation: page-entrance 350ms var(--ease-smooth) backwards;
  }
  @keyframes page-entrance {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
