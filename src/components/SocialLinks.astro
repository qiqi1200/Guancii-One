---
// SocialLinks.astro — 社交链接（数据源：site.json → socials）
// url 留空的条目自动跳过；icon 支持 material 符号与内联品牌 SVG
import site from '../site.json';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const socials = (site.socials || []).filter(s => s && s.url);

const materialIcons: Record<string, string> = {
  github: 'code',
  email: 'mail',
  rss: 'rss_feed',
  bilibili: 'smart_display'
};

const brandSvg: Record<string, string> = {
  x: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  weibo: 'M10.098 20.323c-3.977.391-7.414-1.406-7.672-4.02-.259-2.609 2.759-5.047 6.74-5.441 3.979-.394 7.413 1.404 7.671 4.018.259 2.6-2.759 5.049-6.739 5.443zM20.196 9.4a6.905 6.905 0 0 0-1.247-3.31A6.892 6.892 0 0 0 16.3 3.256a.633.633 0 0 0-.742-.127.628.628 0 0 0-.345.529.626.626 0 0 0 .332.487l.004.002c1.302.731 2.381 1.857 3.106 3.248a.627.627 0 0 0 .847.284.634.634 0 0 0 .347-.525.631.631 0 0 0-.062-.294zm-2.993.124a3.938 3.938 0 0 0-.831-2.368 3.937 3.937 0 0 0-2.078-1.468.635.635 0 0 0-.794.39.637.637 0 0 0 .39.796l.006.002a2.663 2.663 0 0 1 1.406.994 2.662 2.662 0 0 1 .56 1.602.637.637 0 0 0 .637.634.635.635 0 0 0 .634-.637.566.566 0 0 0 .07.055zm-7.72 8.414c1.42.174 2.582-.491 2.582-1.478 0-.99-1.162-1.933-2.582-2.107-1.422-.173-2.582.492-2.582 1.48 0 .987 1.16 1.93 2.582 2.105z',
  telegram: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z'
};
---
{
  socials.map(s => (
    <a
      href={s.url}
      target={!s.url.startsWith('/') && !s.url.startsWith('mailto:') ? '_blank' : undefined}
      rel={s.url.startsWith('http') ? 'noopener' : undefined}
      aria-label={s.label}
      title={s.label}
      class={`social-link ${className}`}
    >
      {brandSvg[s.id] ? (
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={brandSvg[s.id]} />
        </svg>
      ) : (
        <span class="material-symbols-outlined" aria-hidden="true">
          {materialIcons[s.id] || 'link'}
        </span>
      )}
    </a>
  ))
}

<style>
  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    color: rgb(var(--fg-soft));
    transition:
      color 0.25s var(--ease-smooth),
      background 0.25s var(--ease-smooth),
      transform 0.25s var(--ease-smooth);
  }
  .social-link:hover {
    color: rgb(var(--primary));
    background: rgb(var(--primary-light) / 0.1);
    transform: translateY(-1px);
  }
  .social-link svg {
    width: 1rem;
    height: 1rem;
  }
</style>
